pipeline {
    agent any
    
    environment {
        VERCEL_TOKEN = credentials('vercel_token')
    }

    stages {
        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }
        
        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }
        
        stage('Deploy to Vercel') {
            steps {
                sh 'npx vercel --prod --token=${VERCEL_TOKEN} --yes'
            }
        }
    }
    
    post {
        success {
            echo 'Deployment successful!'
        }
        failure {
            echo 'Deployment failed!'
        }
    }
}